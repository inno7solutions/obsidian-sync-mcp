# Required
COUCHDB_PASSWORD=<generate-a-strong-password>
MCP_AUTH_TOKEN=<generate-a-strong-password>
VAULT_NAME=MyVault

# LiveSync user (recommended — limited permissions for sync)
LIVESYNC_USER=livesync
LIVESYNC_PASSWORD=<generate-a-strong-password>

# E2E encryption (only if enabled in LiveSync plugin)
# COUCHDB_PASSPHRASE=your-passphrase

# Defaults (usually don't need to change)
# COUCHDB_USER=admin
# COUCHDB_DATABASE=obsidian

# --- Team auth: identity provider instead of a shared password ---
# Mutually exclusive with MCP_AUTH_TOKEN. See README "Team mode".
# IDP_PROVIDER=azure                    # azure | google | generic
# IDP_CLIENT_ID=<app-client-id>
# IDP_CLIENT_SECRET=<app-client-secret>
# IDP_TENANT_ID=<tenant-id>             # azure only
# IDP_AUTHORIZATION_ENDPOINT=           # generic only
# IDP_TOKEN_ENDPOINT=                   # generic only
# Set at least one of these two, or anyone your IdP issues a token to gets in:
# IDP_REQUIRED_GROUPS=vault-team
# IDP_ALLOWED_DOMAINS=example.com
# Per-user write access (IdP mode only). First match wins; default deny.
# POLICY=[{"group":"vault-editors","writeFolders":["Projects","Inbox"]},{"group":"*","readOnly":true}]
