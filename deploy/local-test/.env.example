# Local test config. Copy to .env and fill in. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32

# CouchDB server admin — used only by the admin UI (and the couchdb container).
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=<openssl rand -hex 16>

# Non-admin CouchDB account the MCP server uses. The admin UI creates it and
# adds it to every vault database.
MCP_SERVICE_PASSWORD=<openssl rand -hex 32>

# Encrypts vault E2E passphrases in the registry (admin + MCP).
# Losing it means re-creating encrypted vaults.
REGISTRY_KEY=<openssl rand -hex 32>

# Encrypts users' CouchDB passwords in the registry (admin only; must differ
# from REGISTRY_KEY). Losing it means resetting all user passwords.
CREDENTIALS_KEY=<openssl rand -hex 32>

# Login for the admin UI at http://localhost:8788
ADMIN_TOKEN=<openssl rand -hex 32>

# URLs as users reach them — baked into Setup URIs and client config snippets.
PUBLIC_COUCHDB_URL=http://localhost:5984
PUBLIC_MCP_URL=http://localhost:8787/mcp
