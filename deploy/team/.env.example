# Team deployment config. Copy to .env and fill in. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32

# CouchDB server admin — used only by the admin UI (and the couchdb container).
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=<strong-random-password>

# Non-admin CouchDB account the MCP server uses. The admin UI creates it and
# adds it to every vault database.
MCP_SERVICE_PASSWORD=<strong-random-password>

# Encrypts vault E2E passphrases in the registry (admin + MCP).
# Losing it means re-creating encrypted vaults.
REGISTRY_KEY=<long-random-secret>

# Encrypts users' CouchDB passwords in the registry (admin only; must differ
# from REGISTRY_KEY). Losing it means resetting all user passwords.
CREDENTIALS_KEY=<long-random-secret>

# Login for the admin UI.
ADMIN_TOKEN=<long-random-secret>

# Public URLs (must match the Caddy hostnames). Baked into Setup URIs and the
# client config snippet shown when a token is issued.
PUBLIC_COUCHDB_URL=https://couch.example.com
PUBLIC_MCP_URL=https://vault.example.com/mcp
