# Team deployment config. Copy to .env and fill in. Never commit the real .env.

# --- Vault + CouchDB ---
VAULT_NAME=TeamKnowledge
COUCHDB_USER=admin
COUCHDB_PASSWORD=<strong-random-password>
# Only if LiveSync E2E encryption is on (must match the plugin's passphrase):
# COUCHDB_PASSPHRASE=<livesync-e2e-passphrase>

# --- Public URL (must match the Caddy hostname exactly) ---
# This is the OAuth token issuer and audience, so it has to be the URL clients
# actually reach.
BASE_URL=https://vault.example.com

# --- Identity provider (generic OIDC: Keycloak / Authentik / Okta) ---
# Endpoints come from your IdP's /.well-known/openid-configuration.
IDP_PROVIDER=generic
IDP_AUTHORIZATION_ENDPOINT=https://idp.example.com/application/o/authorize/
IDP_TOKEN_ENDPOINT=https://idp.example.com/application/o/token/
IDP_CLIENT_ID=<client-id>
IDP_CLIENT_SECRET=<client-secret>
# Only these groups can reach the vault at all (the read boundary):
IDP_REQUIRED_GROUPS=vault-team
# Which ID-token claim carries group membership (configure a mapper in the IdP):
IDP_GROUPS_CLAIM=groups

# --- Per-user write policy (first match wins; no match = read-only) ---
POLICY=[{"group":"vault-editors","writeFolders":["Projects","Inbox"]},{"group":"*","readOnly":true}]

# --- Break-glass local admin (works even if the IdP is down; for you + scripts) ---
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=<long-random-secret>
ADMIN_EMAIL=admin@example.com

# --- Audit log ---
AUDIT_LOG_FILE=/data/audit.jsonl
