# Replace vault.example.com with your real hostname. Caddy fetches and renews a
# Let's Encrypt certificate automatically on first boot (ports 80 + 443 must be
# reachable from the internet, and DNS must already point here).

vault.example.com {
	reverse_proxy mcp:8787
}

